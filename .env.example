# LLM (Phase 2+)
ANTHROPIC_API_KEY=

# Vector store: leave QDRANT_URL empty to use embedded local storage at QDRANT_PATH
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=clinical_guidelines

# Embeddings (fastembed, runs locally)
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# Chunking
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=100

# Retrieval: hybrid candidates -> cross-encoder rerank -> top K; refuse below MIN_RELEVANCE
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
MIN_RELEVANCE=0.2

# Answer generation
LLM_MODEL=claude-opus-5-5
ANSWER_EFFORT=medium
REWRITE_EFFORT=low
HISTORY_TURNS=6
REASONING_EFFORT=high
LLM_TIMEOUT_S=300

# Chat memory: leave empty for in-process memory (dev); postgresql://... in prod
POSTGRES_URL=

# Patient analysis workflow
EVIDENCE_PER_FINDING=3
MAX_EVIDENCE=15
MAX_REVISIONS=2

# Agent tools: empty runs the MCP tool server in-process; or a stdio command for an external one
MCP_SERVER_COMMAND=

# Guardrails: identifiers are pseudonymised before LLM calls. Presidio NER needs the spaCy
# model (uv run python -m spacy download en_core_web_lg); without it, regex recognizers only.
PII_REDACTION=true
PII_SPACY_MODEL=en_core_web_lg

# Clinician feedback (JSONL) for the learning loop
FEEDBACK_PATH=storage/feedback.jsonl
